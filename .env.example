# LedgerLens Environment Configuration

# Required: Google AI Studio Gemini API Key (for LLM RAG responses)
GEMINI_API_KEY=

# Optional: Gemini generation model (gemini-1.5-flash is retired)
GENERATION_MODEL=gemini-2.5-flash

# Required for Production: JWT Secret Key
JWT_SECRET=ledgerlens-super-secret-key-change-in-production-2026

# Database & Storage
DATABASE_URL=sqlite:///./ledgerlens.db
REDIS_URL=redis://localhost:6379/0
ES_HOST=http://localhost:9200
ES_INDEX=ledgerlens_chunks

# Ollama Setup (optional for local embeddings)
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma

# Microservices URLs
IDENTITY_SERVICE_URL=http://localhost:8001
INGESTION_SERVICE_URL=http://localhost:8002
RAG_SERVICE_URL=http://localhost:8003
