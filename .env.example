# =============================================================================
# LedgerLens Environment Configuration Template
# =============================================================================
# Copy this template to `.env` at repository root:
#   cp .env.example .env
# Configure all required private secrets before launching services or containers.
# NEVER commit real credentials, passwords, or tokens to version control.
# =============================================================================

# Deployment Environment: "development", "test", or "production"
ENV=development
APP_NAME=LedgerLens

# -----------------------------------------------------------------------------
# 1. AUTHENTICATION & ACCESS CONTROL SECRETS (REQUIRED)
# -----------------------------------------------------------------------------

# Required: JWT signing secret (minimum 32 cryptographically secure bytes).
# Generate using:
#   openssl rand -hex 32
# Startup validation rejects empty keys and insecure defaults (e.g., "secret", "changeme", "admin123").
JWT_SECRET=

# Required for Initial Bootstrap: Initial Administrator Password (12–72 UTF-8 bytes).
# Enforces bcrypt byte boundary. Insecure defaults ("admin123", "password", etc.) are rejected at startup.
ADMIN_INITIAL_PASSWORD=

# Algorithm for signing JWT access tokens: HS256, HS384, or HS512
JWT_ALGORITHM=HS256

# Token expiration in minutes (default: 1440 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# 2. EXTERNAL AI & EMBEDDING PROVIDERS (MANDATORY REAL ENGINES)
# -----------------------------------------------------------------------------

# Mandatory for Financial Answer Generation: Google AI Studio Gemini API Key.
# Required for live grounded financial reasoning. If omitted or invalid, live chat/evaluations fail honestly (no fake answers).
# Obtain/rotate via: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Generation LLM model name
GEMINI_MODEL=gemini-3.5-flash-lite

# RAG Generator Adapter: "gemini" (production/live) or "deterministic" (isolated tests only)
# WARNING: "deterministic" is permitted ONLY when ENV=test for automated behavior harnesses.
RAG_GENERATOR_ADAPTER=gemini

# Mandatory Local Vector Embeddings: Ollama endpoint & model.
# LedgerLens uses real Ollama embeddings (no fake vectors).
# Pull model before running: ollama pull embeddinggemma
# NOTE FOR DOCKER CONTAINERS:
# Inside Docker containers, "localhost" points to the container itself, NOT the host machine running Ollama.
#   - macOS & Windows (Docker Desktop): use http://host.docker.internal:11434
#   - Linux: use http://172.17.0.1:11434 (default docker0 bridge gateway) or configure container host routing
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMS=768
EMBEDDING_BATCH_SIZE=32

# LLM / AI generation timeout in seconds
AI_TIMEOUT_SECONDS=120

# Token budgets for retrieval and context window packing
CHUNK_TOKENS=512
CHUNK_OVERLAP=50
GENERATION_CONTEXT_TOKENS=12000

# -----------------------------------------------------------------------------
# 3. DOCUMENT INGESTION & IBM DOCLING PARSER
# -----------------------------------------------------------------------------

# IBM Docling is the sole layout-aware PDF parser.
# Device execution target: "cpu" (default), "cuda", "mps", or "auto" (explicit accelerator opt-in)
DOCLING_DEVICE=cpu

# Maximum processing time in seconds for a single PDF in Docling worker before timeout termination
PARSER_TIMEOUT_SECONDS=300

# Document upload storage directory (durable named volume in Docker)
UPLOAD_DIR=./data/uploads

# Upload limits, enforced before anything is queued (parsing cost grows with pages)
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PAGES=40

# Streaming chunk size for bounded multipart upload processing (64 KiB)
UPLOAD_READ_BYTES=65536

# Background ingestion workers; each parse is CPU- and memory-heavy
INGESTION_WORKERS=1

# Docker resource caps for the ingestion container
INGESTION_CPUS=2
INGESTION_MEMORY=4g

# Ingestion job lease duration in seconds (prevents worker starvation on crash)
JOB_LEASE_SECONDS=300

# Ingestion worker database polling interval in seconds
WORKER_POLL_SECONDS=1

# -----------------------------------------------------------------------------
# 4. PERSISTENCE & DATA STORES
# -----------------------------------------------------------------------------

# Relational Database URL:
#   - Local development default: sqlite:///./ledgerlens.db
#   - Containerized production:   postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/ledgerlens
DATABASE_URL=sqlite:///./ledgerlens.db

# PostgreSQL container credentials (required when deploying via Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ledgerlens

# Redis URL for token revocation blocklist, distributed session leases, and worker state
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2.0

# Elasticsearch Host and Index configuration
ES_HOST=http://localhost:9200
ES_INDEX=ledgerlens_chunks_v2
ES_USERNAME=
ES_PASSWORD=

# -----------------------------------------------------------------------------
# 5. MICROSERVICES & NETWORKING
# -----------------------------------------------------------------------------

# Downstream service addresses (private loopback for local runner, container names in Docker network)
IDENTITY_SERVICE_URL=http://localhost:8001
INGESTION_SERVICE_URL=http://localhost:8002
RAG_SERVICE_URL=http://localhost:8003

# Edge Exposure Ports and Bind Hosts (strictly bound to loopback 127.0.0.1 by default)
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8000
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=3000

# Allowed CORS origins as a JSON array (default empty list enforces same-origin policy via reverse proxy)
# Example for separate frontend dev server: CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ORIGINS=[]

# Network request & readiness probe timeouts in seconds
REQUEST_TIMEOUT_SECONDS=300
READINESS_TIMEOUT_SECONDS=2.0

# Active conversation lock lease duration in seconds (must be greater than AI_TIMEOUT_SECONDS)
CONVERSATION_LEASE_SECONDS=300

# -----------------------------------------------------------------------------
# 6. CREDENTIAL ROTATION INSTRUCTIONS
# -----------------------------------------------------------------------------
# 1. Google Gemini API Key:
#    - Generate a new key in Google AI Studio (https://aistudio.google.com/app/apikey).
#    - Update GEMINI_API_KEY in deployment environment / secret manager.
#    - Restart RAG Engine service (`rag`).
#    - Revoke the old key in Google AI Studio console.
#
# 2. JWT Signing Secret:
#    - Generate a new 32+ byte secret: openssl rand -hex 32
#    - Update JWT_SECRET in environment.
#    - Restart all services simultaneously.
#    - Note: Rotating JWT_SECRET immediately invalidates all active user sessions,
#      forcing client re-authentication.
#
# 3. Administrator Password:
#    - Update ADMIN_INITIAL_PASSWORD prior to first startup.
#    - For existing installations, use database administration or identity endpoints
#      to update user credentials.
#
# 4. PostgreSQL Credentials:
#    - Update POSTGRES_PASSWORD in .env and ALTER USER postgres WITH PASSWORD in PostgreSQL.
#    - Restart all dependent backend services.
